{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "/opt/homebrew/bin/node",
      "runtimeArgs": ["-e", "process.chdir('apps/web'); require('next/dist/bin/next')"],
      "port": 3000,
      "env": {
        "NODE_ENV": "development",
        "PORT": "3000"
      }
    },
    {
      "name": "api",
      "runtimeExecutable": "/opt/homebrew/bin/node",
      "runtimeArgs": ["node_modules/.bin/tsx", "watch", "apps/api/src/server.ts"],
      "port": 3001
    }
  ]
}
