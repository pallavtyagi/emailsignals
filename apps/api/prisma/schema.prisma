generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Workspace & Auth ───────────────────────────────────

model Workspace {
  id             String   @id @default(uuid())
  clerkOrgId     String   @unique @map("clerk_org_id")
  name           String
  slug           String   @unique
  logoUrl        String?  @map("logo_url")
  physicalAddress String? @map("physical_address") // CAN-SPAM compliance
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  domains        Domain[]
  contacts       Contact[]
  contactLists   ContactList[]
  customFields   CustomFieldDefinition[]
  templates      Template[]
  campaigns      Campaign[]
  emailEvents    EmailEvent[]
  suppressions   Suppression[]
  subscription   Subscription?
  apiKeys        ApiKey[]
  webhookEndpoints WebhookEndpoint[]

  @@map("workspaces")
}

// ─── Domain Management ──────────────────────────────────

model Domain {
  id              String       @id @default(uuid())
  workspaceId     String       @map("workspace_id")
  domain          String
  status          DomainStatus @default(PENDING)
  spfValid        Boolean      @default(false) @map("spf_valid")
  dkimValid       Boolean      @default(false) @map("dkim_valid")
  dmarcValid      Boolean      @default(false) @map("dmarc_valid")
  sesIdentityArn  String?      @map("ses_identity_arn")
  reputationScore Int?         @map("reputation_score")
  warmupEnabled   Boolean      @default(true) @map("warmup_enabled")
  warmupDay       Int          @default(0) @map("warmup_day")
  dnsRecords      Json?        @map("dns_records")
  verifiedAt      DateTime?    @map("verified_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  // Relations
  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns       Campaign[]

  @@unique([workspaceId, domain])
  @@index([workspaceId])
  @@map("domains")
}

enum DomainStatus {
  PENDING
  VERIFIED
  DEGRADED
  FAILED
}

// ─── Contact Management ─────────────────────────────────

model Contact {
  id             String        @id @default(uuid())
  workspaceId    String        @map("workspace_id")
  email          String
  firstName      String?       @map("first_name")
  lastName       String?       @map("last_name")
  company        String?
  phone          String?
  status         ContactStatus @default(SUBSCRIBED)
  tags           String[]      @default([])
  customFields   Json          @default("{}") @map("custom_fields")
  consentSource  String?       @map("consent_source")
  consentedAt    DateTime?     @map("consented_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  // Relations
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  listMemberships ContactListMembership[]
  emailEvents    EmailEvent[]

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([email])
  @@map("contacts")
}

enum ContactStatus {
  SUBSCRIBED
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
}

model ContactList {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberships ContactListMembership[]
  campaigns   CampaignList[]
  exclusions  CampaignExclusion[]

  @@index([workspaceId])
  @@map("contact_lists")
}

model ContactListMembership {
  id        String   @id @default(uuid())
  contactId String   @map("contact_id")
  listId    String   @map("list_id")
  addedAt   DateTime @default(now()) @map("added_at")

  // Relations
  contact   Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  list      ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([contactId, listId])
  @@index([listId])
  @@map("contact_list_memberships")
}

model CustomFieldDefinition {
  id          String          @id @default(uuid())
  workspaceId String          @map("workspace_id")
  name        String
  key         String
  type        CustomFieldType @default(TEXT)
  createdAt   DateTime        @default(now()) @map("created_at")

  // Relations
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@map("custom_field_definitions")
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
}

// ─── Suppression ────────────────────────────────────────

model Suppression {
  id               String           @id @default(uuid())
  workspaceId      String           @map("workspace_id")
  email            String
  reason           SuppressionReason
  sourceCampaignId String?          @map("source_campaign_id")
  note             String?
  suppressedAt     DateTime         @default(now()) @map("suppressed_at")

  // Relations
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@index([email])
  @@map("suppressions")
}

enum SuppressionReason {
  BOUNCE_HARD
  BOUNCE_SOFT_MAX
  COMPLAINT
  UNSUBSCRIBE
  MANUAL
}

// ─── Templates ──────────────────────────────────────────

model Template {
  id           String   @id @default(uuid())
  workspaceId  String   @map("workspace_id")
  name         String
  category     String?
  subject      String
  previewText  String?  @map("preview_text")
  html         String
  text         String?
  editorJson   Json?    @map("editor_json")
  thumbnailUrl String?  @map("thumbnail_url")
  isStarter    Boolean  @default(false) @map("is_starter")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns    Campaign[]

  @@index([workspaceId])
  @@index([workspaceId, category])
  @@map("templates")
}

// ─── Campaign Management ────────────────────────────────

model Campaign {
  id                  String         @id @default(uuid())
  workspaceId         String         @map("workspace_id")
  name                String
  type                CampaignType   @default(BLAST)
  status              CampaignStatus @default(DRAFT)
  subject             String
  previewText         String?        @map("preview_text")
  fromName            String         @map("from_name")
  fromEmail           String         @map("from_email")
  replyTo             String?        @map("reply_to")
  domainId            String         @map("domain_id")
  templateId          String?        @map("template_id")
  html                String?
  htmlSnapshot        String?        @map("html_snapshot") // Frozen at send time
  utmParams           Json?          @map("utm_params")
  scheduledAt         DateTime?      @map("scheduled_at")
  sentAt              DateTime?      @map("sent_at")
  completedAt         DateTime?      @map("completed_at")
  estimatedRecipients Int            @default(0) @map("estimated_recipients")
  sentCount           Int            @default(0) @map("sent_count")
  tags                String[]       @default([])
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  // Relations
  workspace           Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  domain              Domain         @relation(fields: [domainId], references: [id])
  template            Template?      @relation(fields: [templateId], references: [id])
  lists               CampaignList[]
  exclusions          CampaignExclusion[]
  emailEvents         EmailEvent[]
  sendJobs            SendJob[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([status])
  @@map("campaigns")
}

enum CampaignType {
  BLAST
  SCHEDULED
  AB_TEST
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  PAUSED
  CANCELLED
}

model CampaignList {
  campaignId String @map("campaign_id")
  listId     String @map("list_id")

  campaign   Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  list       ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([campaignId, listId])
  @@map("campaign_lists")
}

model CampaignExclusion {
  campaignId String @map("campaign_id")
  listId     String @map("list_id")

  campaign   Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  list       ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([campaignId, listId])
  @@map("campaign_exclusions")
}

// ─── Send Jobs ──────────────────────────────────────────

model SendJob {
  id         String        @id @default(uuid())
  campaignId String        @map("campaign_id")
  contactId  String        @map("contact_id")
  email      String
  status     SendJobStatus @default(QUEUED)
  sesMessageId String?     @map("ses_message_id")
  error      String?
  sentAt     DateTime?     @map("sent_at")
  createdAt  DateTime      @default(now()) @map("created_at")

  // Relations
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([campaignId, status])
  @@index([sesMessageId])
  @@map("send_jobs")
}

enum SendJobStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  SKIPPED
}

// ─── Email Events / Tracking ────────────────────────────

model EmailEvent {
  id          String         @id @default(uuid())
  workspaceId String         @map("workspace_id")
  campaignId  String?        @map("campaign_id")
  contactId   String?        @map("contact_id")
  email       String
  eventType   EmailEventType @map("event_type")
  metadata    Json           @default("{}")
  occurredAt  DateTime       @default(now()) @map("occurred_at")

  // Relations
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([campaignId])
  @@index([contactId])
  @@index([campaignId, eventType])
  @@index([occurredAt])
  @@map("email_events")
}

enum EmailEventType {
  DELIVERED
  OPENED
  CLICKED
  BOUNCED_HARD
  BOUNCED_SOFT
  COMPLAINED
  UNSUBSCRIBED
  FAILED
}

// ─── Billing ────────────────────────────────────────────

model Subscription {
  id                    String             @id @default(uuid())
  workspaceId           String             @unique @map("workspace_id")
  plan                  BillingPlan        @default(STARTER)
  stripeCustomerId      String             @unique @map("stripe_customer_id")
  stripeSubscriptionId  String             @unique @map("stripe_subscription_id")
  status                SubscriptionStatus @default(ACTIVE)
  currentPeriodStart    DateTime           @map("current_period_start")
  currentPeriodEnd      DateTime           @map("current_period_end")
  emailsUsed            Int                @default(0) @map("emails_used")
  emailsLimit           Int                @map("emails_limit")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  // Relations
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

enum BillingPlan {
  STARTER
  GROWTH
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

// ─── API Keys ───────────────────────────────────────────

model ApiKey {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  name        String
  keyHash     String   @unique @map("key_hash")
  keyPrefix   String   @map("key_prefix") // e.g. "sw_live_abc..."
  scopes      String[] @default([])
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("api_keys")
}

// ─── Webhook Endpoints ──────────────────────────────────

model WebhookEndpoint {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  url         String
  events      String[] @default([])
  secret      String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("webhook_endpoints")
}

// ─── Import Jobs ────────────────────────────────────────

model ImportJob {
  id             String          @id @default(uuid())
  workspaceId    String          @map("workspace_id")
  status         ImportJobStatus @default(QUEUED)
  totalSubmitted Int             @default(0) @map("total_submitted")
  processed      Int             @default(0)
  failed         Int             @default(0)
  errors         Json            @default("[]")
  createdAt      DateTime        @default(now()) @map("created_at")
  completedAt    DateTime?       @map("completed_at")

  @@index([workspaceId])
  @@map("import_jobs")
}

enum ImportJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}
